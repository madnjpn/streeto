# RockAuto Service Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
SERVICE_WORKERS=1

# Optional: RockAuto credentials for authenticated features
# ROCKAUTO_EMAIL=your@email.com
# ROCKAUTO_PASSWORD=your_password

# CORS origins (comma-separated)
CORS_ORIGINS=https://streeto.net,http://localhost:3000,http://localhost

# Logging
LOG_LEVEL=INFO