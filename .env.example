# ────────────────────────────────────────────────────────────────
#  STREETO - example environment file.
#
#  The live site runs on `.env.production` (git-ignored). Copy this
#  file to `.env.production` and fill it in, or let `npm run golive`
#  create it for you.
# ────────────────────────────────────────────────────────────────

# Server
NODE_ENV=production
HOST=0.0.0.0
SITE_NAME=STREETO

# ────────────────────────────────────────────────────────────────
#  Production (behind Cloudflare)
# ────────────────────────────────────────────────────────────────
# The address the site is reached on. Used for absolute links and for the
# certificate's host name.
# PUBLIC_URL=https://streeto.net
# The HTTPS port (443) and the plain-HTTP port that only redirects to it.
# PORT=443
# HTTP_PORT=80
# Turn this on when a proxy sits in front, so the app sees the real
# visitor IP and scheme instead of the proxy's.
# TRUST_PROXY=1
# Where the TLS certificate lives. A Cloudflare Origin CA certificate
# (origin.pem + origin-key.pem) is preferred over cert.pem + key.pem.
# CERT_DIR=certs

# Cloudflare dynamic DNS - keeps the A record on the current public IP.
# Only needed without a tunnel; a tunnel needs no DNS at all.
# CF_API_TOKEN=
# CF_ZONE_ID=
# CF_DNS_NAME=streeto.net
# CF_DNS_TYPE=A

# REQUIRED in production. Sessions/CSRF tokens are signed with this.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_MAX_AGE_MS=1209600000

# Storage
DB_PATH=data/streeto.db
UPLOAD_DIR=uploads

# Upload limits (megabytes per file)
MAX_UPLOAD_MB=25

# Traffic fines (My Garage -> Fines)
# The lookup drives a headless Edge/Chrome to protocols.ge, whose API is
# protected by a reCAPTCHA that only the portal itself can satisfy.
# BROWSER_PATH overrides browser auto-detection.
# BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# FINES_TIMEOUT_MS=60000

# Annual technical inspection (pti.ge)
# The lookup runs when a vehicle/build is saved and refreshes stale owner
# pages. A background sweep refreshes every member's stale plates every
# PTI_SCAN_HOURS. Set PTI_LOOKUP=off for offline development or tests.
PTI_LOOKUP=on
# PTI_TIMEOUT_MS=4000
# Refresh a stored result after this many hours (unknown results retry after 1).
# PTI_REFRESH_HOURS=24
# How often the background sweep for all members runs.
# PTI_SCAN_HOURS=24
# PTI_BASE_URL=https://pti.ge/

# Google Gemini API key for certificate OCR.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
# Which Gemini model reads the certificate photo.
GEMINI_MODEL=gemini-2.5-flash
# How long to wait for a Gemini reply (milliseconds).
GEMINI_TIMEOUT_MS=60000
