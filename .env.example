# STREETO environment template.
#
# Development: copy this file to `.env` (git-ignored), then:
#   node server.js
#
# Production: `npm run golive` writes `.env.production`; the live server is
# started with `npm start` (which reads `.env.production`). Never commit
# `.env` or `.env.production`.

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
HTTP_PORT=0
SITE_NAME=STREETO
PUBLIC_URL=
TRUST_PROXY=0
SESSION_SECRET=
SESSION_MAX_AGE_MS=1209600000
CERT_DIR=certs

# Production values (usually written by `npm run golive` into
# .env.production):
# NODE_ENV=production
# PUBLIC_URL=https://streeto.net
# PORT=443
# HTTP_PORT=80
# TRUST_PROXY=1
# SESSION_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# --- storage ---------------------------------------------------------------
DB_PATH=data/streeto.db
UPLOAD_DIR=uploads
UPLOAD_URL=/uploads
BACKUP_DIR=data/backups
BACKUP_INTERVAL_MS=21600000
BACKUP_KEEP=24
MAX_UPLOAD_MB=25

# Whole lari one US dollar buys, used for GEL/USD price display.
USD_TO_GEL=2.7

# --- mail (optional) -------------------------------------------------------
# MAIL_PASS is a Google App Password, not the Gmail account password.
# Without MAIL_PASS password resets are disabled; MAIL_CAPTURE=1 writes
# letters to data/mail-capture/ instead of sending them.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SECURE=1
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=STREETO <streeto.official@gmail.com>
# MAIL_REPLY_TO=
# MAIL_RESET_MINUTES=60
# MAIL_CAPTURE=0

# --- web push (optional) ---------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@streeto.net

# --- annual technical inspection (pti.ge, optional) ------------------------
PTI_LOOKUP=on
# PTI_BASE_URL=https://pti.ge/
# PTI_TIMEOUT_MS=4000
# PTI_REFRESH_HOURS=24
# PTI_SCAN_HOURS=24

# --- traffic fines lookup (optional, Windows desktop browser) -------------
# FINES_TIMEOUT_MS=60000
# BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# CHROME_PATH=
# EDGE_PATH=

# --- certificate OCR (Google Gemini, optional) -----------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=60000

# --- parts catalogue (optional) -------------------------------------------
# The built-in Node client talks to RockAuto through a reader. Set
# ROCKAUTO_SERVICE_URL to use the Python FastAPI service instead
# (rockauto-service/, default http://localhost:8001).
# ROCKAUTO_SERVICE_URL=
# ROCKAUTO_READER=https://r.jina.ai/
# JINA_API_KEY=
# PROXIFLY_API_KEY=
# ROUTE_API=https://router.project-osrm.org/route/v1/driving

# --- Cloudflare tunnel / DDNS (production) --------------------------------
# `npm run golive` writes the tunnel token and creates the tunnel.
# CF_TUNNEL_TOKEN=
# CF_API_TOKEN=
# CF_ZONE_ID=
# CF_DNS_NAME=streeto.net
# CF_DNS_TYPE=A
# CF_DDNS_INTERVAL_MS=300000

# Extra host names for the local self-signed certificate (`npm run cert`),
# comma-separated.
# EXTRA_HOSTS=
