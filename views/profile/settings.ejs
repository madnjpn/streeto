<div class="single single--narrow">
  <p class="eyebrow"><%= t('garage') %></p>
  <h1 class="display"><%= t('Settings') %></h1>
  <p class="lede"><%= t('Your profile, your password, your data.') %></p>

  <section class="card card--form">
    <h2 class="card__title"><%= t('Profile') %></h2>
    <form action="/settings" method="post" enctype="multipart/form-data">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">

      <div class="avatarrow">
        <div class="avatarrow__pic" id="avatarpic" data-avatar-preview data-avatar-class="avatar avatar--lg">
          <%- include('../partials/avatar', { u: currentUser, cls: 'avatar--lg', attrs: 'data-avatar-img' }) %>
        </div>
        <label class="btn btn--ghost btn--sm">
          <%- include('../partials/icon', { name: 'image', size: 16 }) %> <%= t('Change avatar') %>
          <input type="file" name="avatar" accept="image/*" hidden data-avatar-input data-avatar-target="#avatarpic">
        </label>
        <span class="muted small"><%= t('JPG, PNG, WebP, GIF or AVIF up to {mb} MB.', { mb: maxUploadMb }) %></span>
        <span class="avatarrow__note small" data-avatar-note hidden><%= t('Preview - not saved yet') %></span>
      </div>

      <label class="field">
        <span class="field__label"><%= t('Display name') %></span>
        <input type="text" name="display_name" value="<%= values.display_name %>" maxlength="40" placeholder="<%= currentUser.username %>">
      </label>

      <label class="field">
        <span class="field__label"><%= t('Bio') %></span>
        <textarea name="bio" rows="3" maxlength="600" placeholder="<%= t('What you drive, what you\'re building, where you ride.') %>"><%= values.bio %></textarea>
      </label>

      <div class="field-row">
        <label class="field">
          <span class="field__label"><%= t('Car') %></span>
          <input type="text" name="car" value="<%= values.car %>" maxlength="80" placeholder="<%= t('e.g. 1998 Integra Type R') %>">
        </label>
        <label class="field">
          <span class="field__label"><%= t('City') %></span>
          <input type="text" name="city" value="<%= values.city %>" maxlength="80" placeholder="<%= t('e.g. Rotterdam') %>">
        </label>
      </div>

      <fieldset class="field field--radio">
        <legend class="field__label"><%= t('Service provider') %></legend>
        <label class="choice">
          <input type="checkbox" name="is_provider" value="1" <%= values.is_provider ? 'checked' : '' %>>
          <span><strong><%= t('I offer car services') %></strong><small><%= t('Shops, mechanics, tuners, detailers - tick this to show a provider badge on your profile and list services under Maintenance.') %></small></span>
        </label>
        <% if (values.is_provider) { %>
          <p class="provider-earned">
            <span class="badge badge--provider"><%- include('../partials/icon', { name: 'shield', size: 13 }) %> <%= f.providerName(values.provider_name, t) %></span>
          </p>
          <p class="muted small"><%= t('Your provider badge is earned by claiming a service - the name is set from the listing you verified, so it cannot be typed in by hand.') %></p>
        <% } %>
      </fieldset>

      <button class="btn btn--primary" type="submit"><%- include('../partials/icon', { name: 'check', size: 17 }) %> <%= t('Save profile') %></button>
    </form>
  </section>

  <section class="card card--form">
    <h2 class="card__title"><%= t('Theme') %></h2>
    <p class="muted small"><%= t('Pick how STREETO looks. It follows you to every device you log in from.') %></p>
    <div class="themegrid" role="group" aria-label="<%= t('Theme') %>">
      <% themes.forEach(function (th) { %>
        <a class="themecard<%= theme === th.code ? ' is-active' : '' %>"
           href="/theme/<%= th.code %>"
           title="<%= t(th.label) %>"<% if (theme === th.code) { %> aria-current="true"<% } %>>
          <span class="themecard__swatch themecard__swatch--<%= th.code %>" aria-hidden="true"></span>
          <span class="themecard__meta">
            <strong><%= t(th.label) %></strong>
            <small class="muted"><%= t(th.desc) %></small>
          </span>
          <% if (theme === th.code) { %><span class="themecard__check"><%- include('../partials/icon', { name: 'check', size: 14 }) %></span><% } %>
        </a>
      <% }); %>
    </div>
  </section>

  <section class="card card--form" id="updates">
    <h2 class="card__title"><%= t('App & updates') %></h2>
    <p class="muted small"><%= t('Check whether a newer version of STREETO is available.') %></p>
    <div class="kv">
      <span><%= t('Web version') %></span><strong data-web-version>v<%= webVersion %></strong>
      <span><%= t('iOS version') %></span><strong data-ios-version>v<%= webVersion %></strong>
      <span data-app-current-row hidden><%= t('Installed app') %></span><strong data-app-current hidden>-</strong>
      <span><%= t('Latest Android app') %></span><strong><a href="/downloads/STREETO-android.apk" data-app-latest>v<%= androidRelease.versionName || '-' %></a></strong>
    </div>
    <div class="btnrow">
      <button class="btn btn--ghost" type="button" data-check-updates><%- include('../partials/icon', { name: 'exchange', size: 16 }) %> <%= t('Check for updates') %></button>
      <button class="btn btn--ghost" type="button" data-show-changes aria-haspopup="dialog"><%- include('../partials/icon', { name: 'clock', size: 16 }) %> <%= t('Changes') %></button>
      <button class="btn btn--primary" type="button" data-update-now-settings hidden><%- include('../partials/icon', { name: 'download', size: 16 }) %> <%= t('Update now') %></button>
      <button class="btn btn--primary" type="button" data-reload-now hidden><%- include('../partials/icon', { name: 'exchange', size: 16 }) %> <%= t('Reload') %></button>
    </div>
    <p class="small" data-update-status role="status" aria-live="polite"></p>
  </section>

  <section class="card card--form" id="notifications">
    <h2 class="card__title"><%= t('Notifications') %></h2>
    <p class="muted small"><%= t('Get notified about messages, friend requests, comments, likes, meetups and Underground nights.') %></p>
    <div class="kv">
      <span><%= t('Notification status') %></span><strong data-push-state>—</strong>
    </div>
    <div class="btnrow">
      <button class="btn btn--primary" type="button" data-push-enable><%- include('../partials/icon', { name: 'bell', size: 16 }) %> <%= t('Enable notifications') %></button>
      <button class="btn btn--ghost" type="button" data-push-disable hidden><%- include('../partials/icon', { name: 'bell', size: 16 }) %> <%= t('Turn off notifications') %></button>
    </div>
    <p class="small" data-push-status role="status" aria-live="polite"></p>
    <p class="muted small" data-push-note hidden><%= t('Android keeps a small STREETO notification while realtime alerts are on.') %></p>

    <form class="notifprefs" action="/settings/notifications" method="post">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
      <fieldset class="field--radio">
        <legend class="field__label"><%= t('Push categories') %></legend>
        <p class="muted small"><%= t('Choose which alerts can reach your phone. Activity in the bell is always kept.') %></p>
        <label class="check">
          <input type="checkbox" name="notify_messages" value="1" <%= notifyPrefs.messages ? 'checked' : '' %>>
          <span><%= t('Messages') %></span>
        </label>
        <label class="check">
          <input type="checkbox" name="notify_social" value="1" <%= notifyPrefs.social ? 'checked' : '' %>>
          <span><%= t('Friends and comments') %></span>
        </label>
        <label class="check">
          <input type="checkbox" name="notify_groups" value="1" <%= notifyPrefs.groups ? 'checked' : '' %>>
          <span><%= t('Groups') %></span>
        </label>
        <label class="check">
          <input type="checkbox" name="notify_meetups" value="1" <%= notifyPrefs.meetups ? 'checked' : '' %>>
          <span><%= t('Meetups') %></span>
        </label>
        <label class="check">
          <input type="checkbox" name="notify_underground" value="1" <%= notifyPrefs.underground ? 'checked' : '' %>>
          <span><%= t('Underground') %></span>
        </label>
        <label class="check">
          <input type="checkbox" name="notify_builds" value="1" <%= notifyPrefs.builds ? 'checked' : '' %>>
          <span><%= t('Builds') %></span>
        </label>
        <label class="check">
          <input type="checkbox" name="notify_services" value="1" <%= notifyPrefs.services ? 'checked' : '' %>>
          <span><%= t('Services') %></span>
        </label>
      </fieldset>
      <button class="btn btn--ghost" type="submit"><%= t('Save notification settings') %></button>
    </form>
  </section>

  <section class="card card--form">
    <h2 class="card__title"><%= t('Letters') %></h2>
    <p class="muted small"><%= t('The site can write to you now and then - a weekly letter with what happened on the street, and a reminder before a car has to go to the technical inspection.') %></p>
    <form action="/settings/letters" method="post">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
      <label class="check">
        <input type="checkbox" name="mail_digest" value="1" <%= currentUser.mail_digest === 0 ? '' : 'checked' %>>
        <span><%= t('Send me the weekly letter') %></span>
      </label>
      <label class="check">
        <input type="checkbox" name="mail_pti" value="1" <%= currentUser.mail_pti === 0 ? '' : 'checked' %>>
        <span><%= t('Remind me before the technical inspection') %></span>
      </label>
      <div class="btnrow">
        <button class="btn btn--primary" type="submit"><%= t('Save') %></button>
      </div>
    </form>
  </section>

  <section class="card card--form">
    <h2 class="card__title"><%= t('Account') %></h2>
    <p class="muted small"><%= t('Username and email are fixed after sign-up. Contact an admin if you need them changed.') %></p>
    <div class="kv">
      <span><%= t('Username') %></span><strong>@<%= currentUser.username %></strong>
      <span><%= t('Email') %></span><strong><%= currentUser.email %></strong>
      <span><%= t('Member since') %></span><strong><%= f.fullDate(currentUser.created_at) %></strong>
    </div>
  </section>

  <section class="card card--form">
    <h2 class="card__title"><%= t('Change password') %></h2>
    <form action="/settings/password" method="post">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
      <label class="field">
        <span class="field__label"><%= t('Current password') %></span>
        <input type="password" name="current_password" autocomplete="current-password" required>
      </label>
      <div class="field-row">
        <label class="field">
          <span class="field__label"><%= t('New password') %></span>
          <input type="password" name="new_password" autocomplete="new-password" minlength="8" maxlength="128" required data-pw>
        </label>
        <label class="field">
          <span class="field__label"><%= t('Confirm new password') %></span>
          <input type="password" name="confirm_password" autocomplete="new-password" minlength="8" maxlength="128" required>
        </label>
      </div>
      <span class="meter" data-pw-meter aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="field__hint"><%= t('At least 8 characters with a letter and a number.') %></span>
      <button class="btn btn--primary" type="submit"><%- include('../partials/icon', { name: 'key', size: 17 }) %> <%= t('Update password') %></button>
    </form>
  </section>

  <section class="card card--danger">
    <h2 class="card__title"><%= t('Danger zone') %></h2>
    <p class="muted"><%= t('Deleting your account removes your posts, comments, likes, chats and group memberships. This cannot be undone.') %></p>
    <form action="/settings/delete" method="post" data-confirm="<%= t('Delete your account and everything in it? This cannot be undone.') %>">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
      <label class="field">
        <span class="field__label"><%= t('Confirm with your password') %></span>
        <input type="password" name="password" autocomplete="current-password" required>
      </label>
      <button class="btn btn--danger" type="submit"><%- include('../partials/icon', { name: 'trash', size: 17 }) %> <%= t('Delete my account') %></button>
    </form>
  </section>
</div>

<div class="modal" id="changes-modal" role="dialog" aria-modal="true" aria-labelledby="changes-title" hidden>
  <div class="modal__overlay" tabindex="-1" data-dismiss></div>
  <div class="modal__panel">
    <header class="modal__header">
      <h2 id="changes-title"><%- include('../partials/icon', { name: 'clock', size: 18 }) %> <%= t("What's new") %></h2>
      <button class="modal__close btn btn--ghost btn--sm" type="button" data-dismiss aria-label="<%= t('Close') %>"><%- include('../partials/icon', { name: 'x', size: 18 }) %></button>
    </header>
    <div class="modal__body">
      <p class="muted small"><%= t('Everything that changed in recent releases.') %></p>
      <div class="changelog">
        <% changelog.forEach(function (entry) { %>
          <article class="changelog__entry" data-changelog-version="<%= entry.version %>">
            <header class="changelog__head">
              <strong class="changelog__version">v<%= entry.version %></strong>
              <span class="tag tag--tiny"><%= entry.scope === 'both' ? t('Web + Android') : entry.scope === 'android' ? t('Android') : t('Web') %></span>
              <span class="changelog__date"><%= f.shortDate(entry.date) %></span>
              <span class="changelog__state" data-changelog-state hidden></span>
            </header>
            <ul class="changelog__list">
              <% entry.items.forEach(function (item) { %>
                <li><%= t(item) %></li>
              <% }); %>
            </ul>
          </article>
        <% }); %>
      </div>
    </div>
    <div class="modal__footer">
      <button class="btn btn--ghost" type="button" data-dismiss><%= t('Close') %></button>
    </div>
  </div>
</div>
