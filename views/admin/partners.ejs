<div class="pagehead">
  <div class="pagehead__main">
    <p class="eyebrow"><%= t('admin') %></p>
    <h1 class="display"><%= t('Partners') %></h1>
    <p class="lede"><%= t('Manage partner logos displayed on the public Partners page.') %></p>
  </div>
  <a class="btn btn--primary" href="/partners" target="_blank"><%- include('../partials/icon', { name: 'external', size: 16 }) %> <%= t('View public page') %></a>
</div>

<article class="card">
  <h2 class="section-title"><%- include('../partials/icon', { name: 'plus', size: 17 }) %> <%= t('Add partner') %></h2>

  <form action="/admin/partners/new" method="post" enctype="multipart/form-data" id="partner-add-form" class="partneradd">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">

    <label class="pdz" id="partner-drop" for="partner-logo-input">
      <input type="file" name="logo" id="partner-logo-input" accept="image/png,image/jpeg,image/webp,image/svg+xml" required>
      <span class="pdz__icon"><%- include('../partials/icon', { name: 'image', size: 22 }) %></span>
      <span class="pdz__title"><%= t('Drop the logo here, or click to choose a file') %></span>
      <span class="pdz__hint"><%= t('PNG, JPG, WebP or SVG - max 2 MB.') %></span>
    </label>

    <div class="pdz__preview" id="partner-preview" hidden>
      <img class="pdz__preview-img" id="partner-preview-img" alt="">
      <div class="pdz__preview-text">
        <strong id="partner-preview-name">-</strong>
        <span class="muted small" id="partner-preview-file">-</span>
      </div>
      <button type="button" class="btn btn--ghost btn--sm" id="partner-preview-clear"><%= t('Choose another') %></button>
    </div>

    <p class="muted small pdz__note">
      <%- include('../partials/icon', { name: 'tag', size: 13 }) %>
      <%= t('The name is taken from the file name. The link can be added later.') %>
    </p>

    <div class="field field--submit">
      <button class="btn btn--primary" type="submit" id="partner-add-btn" disabled><%= t('Add partner') %></button>
    </div>
  </form>
</article>

<article class="card">
  <h2 class="section-title"><%- include('../partials/icon', { name: 'list', size: 17 }) %> <%= t('Existing partners') %></h2>
  <% if (!partners.length) { %>
    <p class="muted"><%= t('No partners yet. Add one above.') %></p>
  <% } else { %>
    <div class="partneradmin" data-reorder>
      <% partners.forEach(function (p) { %>
        <div class="partneradmin__item" data-id="<%= p.id %>"
             data-name="<%= p.name %>"
             data-url="<%= p.url || '' %>"
             data-active="<%= p.is_active ? '1' : '0' %>"
             data-logo="<%= config.uploadUrl %>/<%= p.logo_path %>">
          <span class="partneradmin__drag" title="<%= t('Drag to reorder') %>"><%- include('../partials/icon', { name: 'grip', size: 12 }) %></span>
          <img class="partneradmin__logo" src="<%= config.uploadUrl %>/<%= p.logo_path %>" alt="<%= p.name %>">
          <span class="partneradmin__name"><%= p.name %></span>
          <% if (p.url) { %>
            <span class="partneradmin__url muted small"><%= p.url %></span>
          <% } else { %>
            <span class="partneradmin__url muted small partneradmin__url--none"><%= t('No link yet') %></span>
          <% } %>
          <% if (!p.is_active) { %><span class="tag tag--tiny"><%= t('Hidden') %></span><% } %>
          <button type="button" class="btn btn--ghost btn--sm partneradmin__edit" data-action="edit" data-id="<%= p.id %>">
            <%- include('../partials/icon', { name: 'edit', size: 13 }) %> <%= t('Edit') %>
          </button>
          <button type="button" class="btn btn--danger btn--sm" data-action="delete" data-id="<%= p.id %>" title="<%= t('Delete') %>"><%- include('../partials/icon', { name: 'trash', size: 13 }) %></button>
        </div>
      <% }); %>
    </div>
  <% } %>
</article>

<!-- Edit partner -->
<div class="modal" id="partner-edit-modal" role="dialog" aria-modal="true" aria-labelledby="partner-edit-title" hidden>
  <div class="modal__overlay" tabindex="-1" data-dismiss></div>
  <div class="modal__panel modal__panel--form">
    <header class="modal__header">
      <h2 id="partner-edit-title"><%- include('../partials/icon', { name: 'edit', size: 18 }) %> <%= t('Edit partner') %></h2>
      <button type="button" class="modal__close btn btn--ghost btn--sm" aria-label="<%= t('Close') %>" data-dismiss><%- include('../partials/icon', { name: 'x', size: 18 }) %></button>
    </header>

    <form class="modal__form" id="partner-edit-form" method="post" enctype="multipart/form-data">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">

      <div class="modal__scroll">
        <div class="partneredit">
          <img class="partneredit__logo" id="partner-edit-logo" alt="">

          <div class="partneredit__fields">
            <label class="field">
              <span><%= t('Name') %></span>
              <input type="text" name="name" id="partner-edit-name" maxlength="80" required>
            </label>

            <label class="field">
              <span><%= t('Website URL') %></span>
              <input type="text" name="url" id="partner-edit-url" inputmode="url" placeholder="https://example.com" autocomplete="off">
              <span class="muted small"><%= t('Optional - a partner without a link is still shown.') %></span>
            </label>

            <label class="field">
              <span><%= t('Replace the logo') %></span>
              <input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/svg+xml">
              <span class="muted small"><%= t('Leave empty to keep the current logo.') %></span>
            </label>

            <label class="check">
              <input type="checkbox" name="is_active" value="1" id="partner-edit-active" checked>
              <span><%= t('Show on the partners page') %></span>
            </label>
          </div>
        </div>
      </div>

      <div class="modal__footer">
        <button type="button" class="btn btn--ghost" data-dismiss><%= t('Cancel') %></button>
        <button type="submit" class="btn btn--primary"><%= t('Save') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Delete confirmation modal -->
<div class="modal" id="partner-delete-modal" role="dialog" aria-modal="true" aria-labelledby="partner-delete-title" hidden>
  <div class="modal__overlay" tabindex="-1" data-dismiss></div>
  <div class="modal__panel">
    <header class="modal__header">
      <h2 id="partner-delete-title"><%= t('Delete partner') %></h2>
      <button type="button" class="modal__close btn btn--ghost btn--sm" aria-label="<%= t('Close') %>" data-dismiss><%- include('../partials/icon', { name: 'x', size: 18 }) %></button>
    </header>
    <div class="modal__body">
      <p class="muted"><%= t('Are you sure you want to delete this partner? This cannot be undone.') %></p>
    </div>
    <div class="modal__footer">
      <button type="button" class="btn btn--ghost" data-dismiss><%= t('Cancel') %></button>
      <button type="button" class="btn btn--danger" id="confirm-delete-btn"><%= t('Delete') %></button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script type="module">
/* The same file the layout loads - a second copy of app.js would run its
   form guard twice and cancel every submit on the page. */
import { openModal, closeModal } from '/assets/<%= assetStamp %>/js/app.js';

const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const csrfToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';

/* ── Add partner: the logo is the only thing asked for ─────────────
   The name is taken from the file name, the same way the server does
   it, so the admin sees the name before the logo is even sent. */
const nameFromFile = (fileName) => {
  const base = String(fileName || '').replace(/\.[a-z0-9]+$/i, '');
  const cleaned = base.replace(/[_-]+/g, ' ').replace(/\s+/g, ' ').trim();
  const trimmed = cleaned.replace(/\s+logo\s*(\d+)?$/i, '').trim();
  return (trimmed || cleaned || 'Partner').slice(0, 80);
};

const fileInput = $('#partner-logo-input');
const drop = $('#partner-drop');
const preview = $('#partner-preview');
const previewImg = $('#partner-preview-img');
const previewName = $('#partner-preview-name');
const previewFile = $('#partner-preview-file');
const previewClear = $('#partner-preview-clear');
const addBtn = $('#partner-add-btn');

function showFile(file) {
  if (!file) {
    preview.hidden = true;
    addBtn.disabled = true;
    return;
  }
  previewImg.src = URL.createObjectURL(file);
  previewName.textContent = nameFromFile(file.name);
  previewFile.textContent = file.name;
  preview.hidden = false;
  addBtn.disabled = false;
}

if (fileInput) {
  fileInput.addEventListener('change', () => showFile(fileInput.files[0]));

  ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  }));
  ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
  }));
  drop.addEventListener('drop', (e) => {
    const file = e.dataTransfer?.files?.[0];
    if (!file) return;
    const dt = new DataTransfer();
    dt.items.add(file);
    fileInput.files = dt.files;
    showFile(file);
  });

  previewClear.addEventListener('click', () => {
    fileInput.value = '';
    showFile(null);
  });
}

/* ── Reorder via drag-and-drop ─────────────────────────────────── */
const grid = $('[data-reorder]');
if (grid && window.Sortable) {
  new Sortable(grid, {
    animation: 150,
    handle: '.partneradmin__drag',
    onEnd() {
      const ids = [...grid.querySelectorAll('[data-id]')].map(e => e.dataset.id);
      fetch('/admin/partners/reorder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ order: ids.map((id, i) => ({ id, position: i })) }),
      });
    }
  });
}

/* ── Edit: the details can be filled in later ──────────────────── */
const editForm = $('#partner-edit-form');
$$('[data-action="edit"]').forEach(btn => {
  btn.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    const row = btn.closest('.partneradmin__item');
    if (!row || !editForm) return;
    editForm.action = '/admin/partners/' + row.dataset.id;
    $('#partner-edit-name').value = row.dataset.name || '';
    $('#partner-edit-url').value = row.dataset.url || '';
    $('#partner-edit-active').checked = row.dataset.active === '1';
    $('#partner-edit-logo').src = row.dataset.logo || '';
    openModal('#partner-edit-modal');
  });
});

/* ── Delete partner - show modal first ─────────────────────────── */
let pendingDeleteId = null;
$$('[data-action="delete"]').forEach(btn => {
  btn.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    pendingDeleteId = btn.dataset.id;
    openModal('#partner-delete-modal');
  });
});

const confirmBtn = document.getElementById('confirm-delete-btn');
if (confirmBtn) {
  confirmBtn.addEventListener('click', async () => {
    if (!pendingDeleteId) return;
    try {
      const res = await fetch('/admin/partners/' + pendingDeleteId + '/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      location.reload();
    } catch (e) {
      console.error('Delete failed:', e);
      alert('Delete failed: ' + e.message);
    } finally {
      pendingDeleteId = null;
      closeModal('#partner-delete-modal');
    }
  });
}
</script>
