<div class="auth">
  <section class="auth__art">
    <div class="auth__art-inner">
      <img class="auth__logo" src="/websitelogo.png" alt="<%= config.siteName %>">
      <p class="eyebrow"><%- include('../partials/icon', { name: 'lock', size: 14 }) %> <%= t('new password') %></p>
      <h1 class="display display--xl"><%- t('YOUR KEYS<br>YOUR RULES') %></h1>
      <p class="lede"><%= t('Pick a password only you know. The old one stops working the moment you save.') %></p>
      <ul class="ticks">
        <li><%- include('../partials/icon', { name: 'shield', size: 16 }) %> <%= t('At least 8 characters, a letter and a number') %></li>
        <li><%- include('../partials/icon', { name: 'bolt', size: 16 }) %> <%= t('Every old session is logged out') %></li>
        <li><%- include('../partials/icon', { name: 'mail', size: 16 }) %> <%= t('This link dies once the new password is saved') %></li>
      </ul>
    </div>
  </section>

  <section class="auth__panel">
    <% if (bad) { %>
      <div class="card card--form">
        <h2 class="card__title"><%= t('The link is no longer good') %></h2>
        <p class="muted"><%= t('A recovery link works once and only for a short while. Ask for a fresh one - it takes a second.') %></p>
        <a class="btn btn--primary btn--block" href="/forgot"><%- include('../partials/icon', { name: 'bolt', size: 17 }) %> <%= t('Ask for a new link') %></a>
        <p class="muted small"><%= t('Remembered it?') %> <a class="link" href="/login"><%= t('Back to log in') %></a>.</p>
      </div>
    <% } else { %>
      <form class="card card--form" action="/reset/<%= token %>" method="post" novalidate>
        <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
        <h2 class="card__title"><%= t('Set a new password') %></h2>
        <p class="muted"><%= t('For @{user}. Type it twice and it is done.', { user: username }) %></p>

        <% if (error) { %>
          <div class="alert alert--error"><%- include('../partials/icon', { name: 'alert', size: 18 }) %> <span><%= error %></span></div>
        <% } %>

        <label class="field">
          <span class="field__label"><%= t('New password') %></span>
          <span class="field__pw">
            <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required autofocus>
            <button type="button" class="field__eye" data-pw-toggle aria-label="<%= t('Show password') %>"><%- include('../partials/icon', { name: 'eye', size: 18 }) %></button>
          </span>
          <span class="field__hint"><%= t('At least 8 characters, a letter and a number') %></span>
        </label>

        <label class="field">
          <span class="field__label"><%= t('Repeat the password') %></span>
          <span class="field__pw">
            <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" required>
            <button type="button" class="field__eye" data-pw-toggle aria-label="<%= t('Show password') %>"><%- include('../partials/icon', { name: 'eye', size: 18 }) %></button>
          </span>
        </label>

        <button class="btn btn--primary btn--block" type="submit"><%- include('../partials/icon', { name: 'lock', size: 17 }) %> <%= t('Save the new password') %></button>
      </form>
    <% } %>
  </section>
</div>
