<%
  /* Miniature registration certificate used in Fines as the technical
     passport badge. Reuses the My Ride certificate styling so both look
     like the same document. */
  const esc = f.escapeHtml;
  const plateText = (value) => (value || '').replace(/[^A-Za-z0-9]/g, '').replace(/^([A-Za-z]{2})([0-9]{3})([A-Za-z]{2})$/, '$1-$2-$3');
  const fmtDate = (value) => {
    if (!value) return '';
    const m = String(value).match(/^(\d{4})-(\d{2})-(\d{2})/);
    return m ? `${m[3]}/${m[2]}/${m[1]}` : String(value);
  };
  const rows = [];
  if (v.number_plate) rows.push(['A', plateText(v.number_plate), t('Registration number')]);
  if (v.year) rows.push(['B', v.year, t('Manufacture year')]);
  if (v.registration_date) rows.push(['I', fmtDate(v.registration_date), t('Date of registration')]);
  if (v.owner_surname) rows.push(['C.1.1', v.owner_surname, t('Surname')]);
  if (v.owner_name) rows.push(['C.1.2', v.owner_name, t('Name')]);
  if (v.owner_address) rows.push(['C.1.3', v.owner_address, t('Address'), true]);
  if (v.owner_id) rows.push(['C.1.4', v.owner_id, t('Personal number')]);
  if (v.owner_of_vehicle) rows.push(['C.4(a)', v.owner_of_vehicle, t('Owner of the vehicle'), true]);
  if (v.expiry_date) rows.push(['H', fmtDate(v.expiry_date), t('Expiration date')]);
%>
<article class="regcert regcert--badge" aria-label="<%= t('Registration certificate') %>">
  <div class="regcert__head">
    <span class="regcert__ge" aria-hidden="true">GE</span>
    <div class="regcert__title">
      <span class="regcert__title-ka">რეგისტრაციის მოწმობა</span>
      <span class="regcert__title-en">REGISTRATION CERTIFICATE</span>
      <span class="regcert__country">საქართველო / GEORGIA</span>
    </div>
  </div>

  <div class="regcert__rows">
    <% rows.forEach(function (row) { %>
      <div class="regcert__row">
        <span class="regcert__code"><%= row[0] %></span>
        <span class="regcert__value-wrap"><span class="regcert__value<%= row[3] ? ' regcert__value--wrap' : '' %>" title="<%= esc(row[1]) %>"><%= esc(row[1]) %></span></span>
        <span class="regcert__label"><%= row[2] %></span>
      </div>
    <% }); %>
  </div>

  <footer class="regcert__foot cert-badge__foot">
    <span class="cert-badge__passport">
      <span class="regcert__passport"><%= esc(v.technical_passport) %></span>
      <span class="cert-badge__passport-label">ტექ. პასპორტი</span>
      <span class="cert-badge__passport-label">Technical passport</span>
    </span>
    <span class="regcert__issuer cert-badge__issuer">მოწმობა გაცემულია შსს მომსახურების სააგენტოს მიერ<br>Certificate is issued by Service Agency of MIA</span>
    <span class="cert-badge__seal" aria-hidden="true">GE</span>
  </footer>
</article>
