<%
  const currentPath = typeof path !== 'undefined' ? path : '/';
  const chatOpen = typeof query !== 'undefined' && Boolean(query.chat);
  const chatUnread = typeof unreadMessages !== 'undefined' ? Number(unreadMessages) || 0 : 0;
  const tabActive = (key) => {
    if (key === 'chat') return chatOpen || typeof active !== 'undefined' && active === 'chat';
    if (key === 'garage') return currentPath.startsWith('/garage');
    if (key === 'meetups') return currentPath.startsWith('/meetups') || currentPath.startsWith('/routes');
    if (key === 'explore') return ['/explore', '/near', '/builds', '/groups', '/services', '/search'].some((p) => currentPath.startsWith(p));
    return currentPath === '/';
  };
%>
<nav class="tabbar" aria-label="<%= t('Main') %>" data-tabbar>
  <a class="tabbar__item <%= tabActive('wall') ? 'is-active' : '' %>" href="/">
    <span class="tabbar__icon"><%- include('icon', { name: 'wall', size: 22 }) %></span>
    <span class="tabbar__label"><%= t('Wall') %></span>
  </a>
  <a class="tabbar__item <%= tabActive('explore') ? 'is-active' : '' %>" href="/explore">
    <span class="tabbar__icon"><%- include('icon', { name: 'search', size: 22 }) %></span>
    <span class="tabbar__label"><%= t('Explore') %></span>
  </a>
  <a class="tabbar__item <%= tabActive('meetups') ? 'is-active' : '' %>" href="/meetups">
    <span class="tabbar__icon"><%- include('icon', { name: 'pin', size: 22 }) %></span>
    <span class="tabbar__label"><%= t('Meetups') %></span>
  </a>
  <a class="tabbar__item <%= tabActive('chat') ? 'is-active' : '' %>" href="/?chat=1">
    <span class="tabbar__icon">
      <%- include('icon', { name: 'chat', size: 22 }) %>
      <span class="tabbar__badge pip pip--solid" data-badge="chat" <%= chatUnread ? '' : 'hidden' %>><%= chatUnread > 9 ? '9+' : chatUnread %></span>
    </span>
    <span class="tabbar__label"><%= t('Chat') %></span>
  </a>
  <a class="tabbar__item <%= tabActive('garage') ? 'is-active' : '' %>" href="/garage">
    <span class="tabbar__icon"><%- include('icon', { name: 'key', size: 22 }) %></span>
    <span class="tabbar__label"><%= t('Garage') %></span>
  </a>
</nav>
