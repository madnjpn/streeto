<%
  const filterUrl = (nextFilter, nextCategory = category) =>
    `/notifications?filter=${nextFilter}${nextCategory ? `&type=${nextCategory}` : ''}`;
  const categoryUrl = (nextCategory) =>
    `/notifications?filter=${filter}${nextCategory ? `&type=${nextCategory}` : ''}`;
  const categoryLabels = {
    messages: t('Messages'),
    social: t('Friends and comments'),
    groups: t('Groups'),
    meetups: t('Meetups'),
    underground: t('Underground'),
    builds: t('Builds'),
    services: t('Services'),
  };
%>
<div class="pagehead">
  <div class="pagehead__main">
    <p class="eyebrow"><%= t('activity') %></p>
    <h1 class="display"><%= t('What you missed') %></h1>
    <p class="lede"><%= t('Friend requests, comments, likes, invites, sale alerts and meetup updates.') %></p>
  </div>
  <div class="pagehead__actions">
    <% if (unread) { %>
      <form action="/notifications/read" method="post">
        <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
        <button class="btn btn--primary btn--sm" type="submit"><%- include('../partials/icon', { name: 'check', size: 15 }) %> <%= t('Mark all read') %></button>
      </form>
    <% } %>
    <% if (items.length) { %>
      <form action="/notifications/clear" method="post">
        <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
        <button class="btn btn--ghost btn--sm" type="submit"><%- include('../partials/icon', { name: 'trash', size: 15 }) %> <%= t('Clear all') %></button>
      </form>
    <% } %>
  </div>
</div>

<div class="feedtabs">
  <a class="feedtabs__tab <%= filter === 'all' ? 'is-active' : '' %>" href="<%= filterUrl('all', '') %>"><%= t('All') %></a>
  <a class="feedtabs__tab <%= filter === 'unread' ? 'is-active' : '' %>" href="<%= filterUrl('unread', '') %>"><%= t('Unread') %><% if (unread) { %> <span class="feedtabs__count"><%= unread %></span><% } %></a>
</div>

<nav class="chips" aria-label="<%= t('Notification types') %>">
  <a class="chip <%= !category ? 'is-active' : '' %>" href="<%= categoryUrl('') %>"><%= t('All') %></a>
  <% Object.keys(categories).forEach(function (key) { %>
    <a class="chip <%= category === key ? 'is-active' : '' %>" href="<%= categoryUrl(key) %>"><%= categoryLabels[key] %></a>
  <% }); %>
</nav>

<% if (!items.length) { %>
  <%- include('../partials/empty', {
    icon: 'bell',
    title: filter === 'unread' ? t('No unread activity') : category ? t('Nothing in this filter') : t('No activity yet'),
    text: filter === 'unread' ? t('You are all caught up.') : t('Post something, add friends or join a group and this fills up fast.'),
  }) %>
<% } else { %>
  <ul class="rows rows--activity">
    <% items.forEach(function (n) { %>
      <%
        /* Notification text is stored as "key" or "key|name" so the reader's
           language decides the wording (see the notify() call sites). */
        const parts = String(n.text || '').split('|');
        const notifVars = parts.length > 1 ? { name: parts.slice(1).join('|') } : undefined;
      %>
      <li class="row row--activity row--stack <%= !n.read_at ? 'is-fresh' : '' %>">
        <% if (!n.read_at) { %><span class="sr-only"><%= t('Unread') %></span><% } %>
        <a class="row__id" href="/notifications/open/<%= n.id %>">
          <% if (n.actor_username) { %>
            <%- include('../partials/avatar', { u: { username: n.actor_username, display_name: n.actor_display_name, avatar: n.actor_avatar }, cls: 'avatar--sm' }) %>
          <% } else { %>
            <span class="avatar avatar--sm avatar--gen" style="--h:<%= f.hueOf(n.type) %>"><%- include('../partials/icon', { name: 'bell', size: 16 }) %></span>
          <% } %>
          <span>
            <% if (n.actor_username) { %><strong>@<%= n.actor_username %></strong> <% } %>
            <span><%= t(parts[0], notifVars) %></span>
            <span class="muted small">· <%= f.timeAgo(n.created_at) %></span>
          </span>
        </a>
        <% if (!n.read_at) { %><span class="pip pip--solid" aria-hidden="true"></span><% } %>
      </li>
    <% }); %>
  </ul>
<% } %>
