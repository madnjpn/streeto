    <h1 class="display"><%= t('My Garage') %></h1>
    <p class="lede"><%= t('Manage your personal vehicles, track maintenance, and check fines.') %></p>
  </div>
</div>

<section class="srvhub">
  <a class="srvhub__card card" href="/garage/ride">
    <span class="srvhub__icon"><%- include('../partials/icon', { name: 'key', size: 26 }) %></span>
