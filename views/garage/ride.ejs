            '<div class="camera-notes">' +
              '<p class="camera-side-title" data-cam-side-title></p>' +
              '<p class="camera-status" data-cam-status>Starting camera…</p>' +
            '</div>' +
            '<div class="camera-controls">' +
              '<button type="button" class="btn btn--ghost btn--sm" data-cam-file title="Use the phone camera app instead">Camera app</button>' +
              '<button type="button" class="btn btn--secondary btn--sm" data-cam-switch>Switch</button>' +
              '<button type="button" class="btn btn--primary" data-cam-shot>Capture</button>' +
              '<button type="button" class="btn btn--ghost btn--sm" data-cam-cancel>Cancel</button>' +
