      camEl.querySelector('[data-cam-file]').addEventListener('click', function() {
        hideCamera();
        ensureFileInput().click();
      });
      camEl.querySelector('[data-cam-side]').addEventListener('click', function() {
        // Only manual scans let the user pick a side. The add-vehicle flow
        // is guided: back first, then front.
        if (scanMode !== 'manual') return;
        scanSide = scanSide === 'front' ? 'back' : 'front';
        updateSideUi();
      });
      window.addEventListener('resize', layoutFrame);
      window.addEventListener('orientationchange', function() {
        setTimeout(layoutFrame, 250);
      });
    }

    // Size and centre the capture frame. CSS aspect-ratio is not reliable
    // on older mobile browsers, so the geometry is computed explicitly.
    // The frame is 3:2 - the real card shape - and takes as much of the
    // visible video area as it can.
    function layoutFrame() {
      if (!camEl || camEl.hidden) return;
      var view = camEl.querySelector('.camera-view');
      var frame = camEl.querySelector('.camera-frame');
      if (!view || !frame) return;
      var vw = view.clientWidth;
      var vh = view.clientHeight;
      if (!vw || !vh) return;

      // The video is object-fit: contain, so work out how big it is drawn.
      var aspect = videoEl && videoEl.videoWidth && videoEl.videoHeight
        ? videoEl.videoWidth / videoEl.videoHeight
        : 4 / 3;
      var drawW = vw;
      var drawH = vw / aspect;
      if (drawH > vh) {
        drawH = vh;
        drawW = vh * aspect;
      }

      var pad = Math.max(6, Math.round(Math.min(drawW, drawH) * 0.03));
      var top = (vh - drawH) / 2;
      var bottom = top + drawH;
      var left = (vw - drawW) / 2;

      // On phones the header, hint bar and controls float over the video.
      // Keep the card frame inside the gap between them.
      var status = camEl.querySelector('[data-cam-status]');
      var controls = camEl.querySelector('.camera-controls');
      if (status && controls && getComputedStyle(status).position === 'absolute') {
        var vr = view.getBoundingClientRect();
        top = Math.max(top, status.getBoundingClientRect().bottom - vr.top + pad);
        bottom = Math.min(bottom, controls.getBoundingClientRect().top - vr.top - pad);
      }
      if (bottom - top < 80) {
        top = (vh - drawH) / 2;
        bottom = top + drawH;
      }

      var availH = Math.max(80, bottom - top);
      var availW = drawW - pad * 2;
      var w = Math.min(availW, availH * 1.5);
      var h = w * 2 / 3;
      if (h > availH) {
        h = availH;
        w = h * 1.5;
      }

      frame.style.width = Math.round(w) + 'px';
      frame.style.height = Math.round(h) + 'px';
      frame.style.left = Math.round(left + drawW / 2) + 'px';
      frame.style.top = Math.round(top + (bottom - top) / 2) + 'px';
    }

    function stopStream() {
      if (camStream) {
        camStream.getTracks().forEach(function(track) {
          try { track.stop(); } catch (err) { /* ignore */ }
        });
        camStream = null;
      }
      if (videoEl) {
        try { videoEl.srcObject = null; } catch (err2) { /* ignore */ }
      }
    }

    // Request the stream the scanner was tuned for. Asking for 4K made many
    // phone cameras pick a noisier, softer mode with worse OCR results.
    function cameraConstraints() {
      return {
        facingMode: { ideal: camFacing },
        width: { min: 1280, ideal: 1920 },
        height: { ideal: 1440 },
        aspectRatio: { ideal: 4 / 3 },
        advanced: [{ zoom: 1 }]
      };
    }

    function startCamera() {
      ensureCamera();
      ensureProgress();
      ensureResult();
      updateSideUi();
      savedOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      camEl.hidden = false;
      setCamStatus('Starting camera…');
      stopStream();
      layoutFrame();
      setTimeout(layoutFrame, 60);

      // Best effort: keep the scanner upright on Android. iOS ignores this,
      // and browsers reject the call outside fullscreen - both are harmless.
      try {
        if (screen.orientation && typeof screen.orientation.lock === 'function') {
          var lock = screen.orientation.lock('portrait');
          if (lock && lock.catch) lock.catch(function() { /* ignore */ });
        }
      } catch (err) { /* ignore */ }

      navigator.mediaDevices.getUserMedia({
        audio: false,
        video: cameraConstraints()
      }).then(function(stream) {
        camStream = stream;
        videoEl.srcObject = stream;
        videoEl.onloadedmetadata = function() {
          layoutFrame();
          var play = videoEl.play();
          if (play && play.catch) play.catch(function() { /* autoplay guard */ });
        };
        var play = videoEl.play();
        if (play && play.catch) play.catch(function() { /* autoplay guard */ });
        updateSideUi();
      }).catch(function(err) {
        console.error('[scan] camera error', err);
        hideCamera();
        if (err && err.name === 'NotAllowedError') {
          alert('Camera permission was blocked. Allow camera access for this site, or use the camera app instead.');
        }
        // Fall back to the native camera/file picker, which works even
        // when getUserMedia is unavailable.
        ensureFileInput().click();
      });
    }

    function hideCamera() {
      stopStream();
      if (camEl) camEl.hidden = true;
      document.body.style.overflow = savedOverflow || '';
      try {
        if (screen.orientation && typeof screen.orientation.unlock === 'function') {
          screen.orientation.unlock();
        }
      } catch (err) { /* ignore */ }
    }

    function switchCamera() {
      camFacing = camFacing === 'environment' ? 'user' : 'environment';
      setCamStatus('Switching camera…');
      stopStream();
      navigator.mediaDevices.getUserMedia({
        audio: false,
        video: cameraConstraints()
      }).then(function(stream) {
        camStream = stream;
        videoEl.srcObject = stream;
        videoEl.onloadedmetadata = layoutFrame;
        var play = videoEl.play();
        if (play && play.catch) play.catch(function() { /* ignore */ });
        updateSideUi();
      }).catch(function(err) {
        console.error('[scan] camera switch error', err);
        setCamStatus('Could not switch camera');
      });
    }

    function takePhoto() {
      if (!videoEl || !videoEl.videoWidth) {
        setCamStatus('Camera is still starting - wait a moment and tap Capture again');
        return;
      }

      var vw = videoEl.videoWidth;
      var vh = videoEl.videoHeight;
      var sx = 0, sy = 0, sw = vw, sh = vh;

      // Crop to what the user framed (3:2 card area), mapping the
      // on-screen frame through the video's `object-fit: contain` transform.
      var view = camEl ? camEl.querySelector('.camera-view') : null;
      var frame = camEl ? camEl.querySelector('.camera-frame') : null;
      if (view && frame) {
        var viewRect = view.getBoundingClientRect();
        var frameRect = frame.getBoundingClientRect();
        if (viewRect.width && viewRect.height && frameRect.width > 40 && frameRect.height > 40) {
          var scale = Math.min(viewRect.width / vw, viewRect.height / vh);
          var offX = (viewRect.width - vw * scale) / 2;
          var offY = (viewRect.height - vh * scale) / 2;
          var fx = (frameRect.left - viewRect.left - offX) / scale;
          var fy = (frameRect.top - viewRect.top - offY) / scale;
          var fw = frameRect.width / scale;
          var fh = frameRect.height / scale;
          fx = Math.max(0, Math.min(vw - 40, fx));
          fy = Math.max(0, Math.min(vh - 40, fy));
          sx = fx;
          sy = fy;
          sw = Math.min(fw, vw - fx);
          sh = Math.min(fh, vh - fy);
        }
      }

      var outW = Math.min(1920, Math.round(sw));
      var outH = Math.max(1, Math.round(outW * sh / sw));
      var canvas = document.createElement('canvas');
      canvas.width = outW;
      canvas.height = outH;
      canvas.getContext('2d').drawImage(videoEl, sx, sy, sw, sh, 0, 0, outW, outH);

      var dataUrl = canvas.toDataURL('image/jpeg', 0.95);
      hideCamera();
      handleDataUrl(dataUrl);
    }

    function handleFile(file) {
      if (!file.type || file.type.indexOf('image/') !== 0) {
        alert('Please choose a photo of the registration certificate.');
        return;
      }
      var reader = new FileReader();
      reader.onload = function(event) { handleDataUrl(event.target.result); };
      reader.onerror = function() { alert('That photo could not be opened. Please try another one.'); };
      reader.readAsDataURL(file);
    }

    function handleDataUrl(dataUrl) {
      hideResult();
      showProgress('Preparing the image…');
      var img = new Image();
      img.onload = function() {
        try {
          runOcr(img);
        } catch (err) {
          hideProgress();
          showResult({}, [], '', err);
        }
      };
      img.onerror = function() {
        hideProgress();
        showResult({}, [], '', new Error('That image could not be decoded.'));
      };
      img.src = dataUrl;
    }

    function preprocessImage(img) {
      var width = img.naturalWidth || img.width;
      var height = img.naturalHeight || img.height;
      // Upscale for better OCR: target at least 2000px on longest side
      var scale = Math.min(3, 2000 / Math.max(width, height));
      if (width * scale < 1600) scale = Math.min(3, 1600 / width);
      var w = Math.max(1, Math.round(width * scale));
      var h = Math.max(1, Math.round(height * scale));
      var canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      var ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, w, h);

      // Grayscale + contrast + denoise + adaptive threshold
      var frame;
      try {
        frame = ctx.getImageData(0, 0, w, h);
      } catch (err) {
        return canvas;
      }
      var data = frame.data;
      var w2 = w, h2 = h;
      
      // 1. Convert to grayscale
      var gray = new Uint8ClampedArray(w2 * h2);
      for (var i = 0, p = 0; i < data.length; i += 4, p++) {
        gray[p] = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
      }
      
      // 2. Contrast stretch (CLAHE-like: stretch 5th-95th percentile)
      var sorted = Array.from(gray).sort((a, b) => a - b);
      var p5 = sorted[Math.floor(sorted.length * 0.05)];
      var p95 = sorted[Math.floor(sorted.length * 0.95)];
      var range = p95 - p5 || 255;
      for (var p = 0; p < gray.length; p++) {
        var v = (gray[p] - p5) * 255 / range;
        gray[p] = v < 0 ? 0 : v > 255 ? 255 : v;
      }
      
      // 3. Light bilateral filter (simplified: 3x3 weighted average preserving edges)
      var denoised = new Uint8ClampedArray(w2 * h2);
      for (var y = 0; y < h2; y++) {
        for (var x = 0; x < w2; x++) {
          var idx = y * w2 + x;
          var sum = 0, wsum = 0;
          for (var dy = -1; dy <= 1; dy++) {
            for (var dx = -1; dx <= 1; dx++) {
              var nx = x + dx, ny = y + dy;
              if (nx >= 0 && nx < w2 && ny >= 0 && ny < h2) {
                var nidx = ny * w2 + nx;
                var diff = Math.abs(gray[idx] - gray[nidx]);
                var w = Math.exp(-diff * diff / 500); // edge-preserving
                sum += gray[nidx] * w;
                wsum += w;
              }
            }
          }
          denoised[idx] = wsum > 0 ? Math.round(sum / wsum) : gray[idx];
        }
      }
      
      // 4. Adaptive threshold (Sauvola-like: local mean - k * local std)
      var binary = new Uint8ClampedArray(w2 * h2);
      var window = 15; // local window size
      var k = 0.3;
      for (var y = 0; y < h2; y++) {
        for (var x = 0; x < w2; x++) {
          var sum = 0, sqsum = 0, count = 0;
          var half = Math.floor(window / 2);
          for (var dy = -half; dy <= half; dy++) {
            for (var dx = -half; dx <= half; dx++) {
              var nx = x + dx, ny = y + dy;
              if (nx >= 0 && nx < w2 && ny >= 0 && ny < h2) {
                var v = denoised[ny * w2 + nx];
                sum += v;
                sqsum += v * v;
                count++;
              }
            }
          }
          var mean = sum / count;
          var variance = sqsum / count - mean * mean;
          var stddev = Math.sqrt(Math.max(0, variance));
          var threshold = mean * (1 + k * (stddev / 128 - 1));
          var idx = y * w2 + x;
          binary[idx] = denoised[idx] > threshold ? 255 : 0;
        }
      }
      
      // 5. Write back to frame (inverted: black text on white)
      for (var p = 0, i = 0; i < data.length; i += 4, p++) {
        var v = binary[p];
        data[i] = data[i + 1] = data[i + 2] = v;
      }
      ctx.putImageData(frame, 0, 0);
      return canvas;
    }

    function loadJsQR() {
      if (window.jsQR) return Promise.resolve(window.jsQR);
      if (window.__streetoJsQR) return window.__streetoJsQR;
      window.__streetoJsQR = new Promise(function(resolve, reject) {
        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js';
        script.async = true;
        script.onload = function() {
          if (window.jsQR) resolve(window.jsQR);
          else reject(new Error('QR decoder did not start.'));
        };
        script.onerror = function() {
          window.__streetoJsQR = null;
          reject(new Error('Could not download the QR decoder.'));
        };
        document.head.appendChild(script);
      });
      return window.__streetoJsQR;
    }

    function decodeQrFromCanvas(canvas) {
      return loadJsQR().then(function(jsQR) {
        var ctx = canvas.getContext('2d');
        var w = canvas.width, h = canvas.height;
        var frame;
        try { frame = ctx.getImageData(0, 0, w, h); } catch (err) { return null; }
        var code = jsQR(frame.data, w, h, { inversionAttempts: 'dontInvert' });
        if (!code || !code.data) {
          // Retry with inverted colours in case the QR is light-on-dark.
          code = jsQR(frame.data, w, h, { inversionAttempts: 'onlyInvert' });
        }
        return code && code.data ? String(code.data) : null;
      }).catch(function() { return null; });
    }

    // OCR runs on the server (Google Gemini) and returns ready-to-use
    // field values, so the browser never has to do any text recognition.
    function runOcr(img) {
      setProgress(0.06, 'Preparing the image…');
      var canvas;
      try {
        canvas = preprocessImage(img);
      } catch (err) {
        canvas = img;
      }

      setProgress(0.25, 'Reading the certificate with AI…');
      canvas.toBlob(function(blob) {
        if (!blob) {
          hideProgress();
          showResult({}, [], '', new Error('Could not read the image.'));
          return;
        }
        var formData = new FormData();
        formData.append('image', blob, 'scan.jpg');
        // The back side prints a picture of the plate, which is not a field.
        formData.append('side', scanSide === 'back' ? 'back' : 'front');
        fetch('/api/ocr/certificate', {
          method: 'POST',
          credentials: 'same-origin',
          body: formData
        }).then(function(resp) {
          if (!resp.ok) {
            return resp.json().catch(function() { return {}; }).then(function(err) {
              throw new Error(err.error || 'The scanner could not read this photo.');
            });
          }
          return resp.json();
        }).then(function(json) {
          hideProgress();
          var fields = json.fields || {};
          var text = json.text || '';
          var filled = applyFields(scanTarget, fields);
          if (scanTarget && scanTarget.hasAttribute && scanTarget.hasAttribute('data-regcert') && filled.length) {
            var frontCount = filled.filter(function(item) {
              return FRONT_FIELDS.indexOf(item.field) >= 0;
            }).length;
            showFace(scanTarget, frontCount >= filled.length - frontCount ? 'front' : 'back');
          }
          showResult(fields, filled, text, null);
        }).catch(function(err) {
          console.warn('[scan] server OCR failed', err);
          hideProgress();
          showResult({}, [], '', err);
        });
      }, 'image/jpeg', 0.92);
    }

    function updateSideUi() {
      if (!camEl) return;
      var isAdd = scanMode === 'add';
      var badge = camEl.querySelector('[data-cam-side]');
      if (badge) {
        badge.textContent = isAdd
          ? (scanSide === 'back' ? '1/2 BACK' : '2/2 FRONT')
          : (scanSide === 'back' ? 'BACK' : 'FRONT');
        badge.classList.toggle('is-button', !isAdd);
        badge.setAttribute('aria-label', isAdd
          ? (scanSide === 'back' ? 'Step 1 of 2, back side' : 'Step 2 of 2, front side')
          : 'Switch to the ' + (scanSide === 'front' ? 'back' : 'front') + ' side');
      }
      var prefix = isAdd
        ? (scanSide === 'back' ? 'Step 1 of 2 - ' : 'Step 2 of 2 - ')
        : '';
      setCamStatus(prefix + (scanSide === 'back'
        ? 'scan the BACK: make, model, VIN'
        : 'scan the FRONT: plate, owner, dates'));

      // The big blue banner names the side that is being scanned.
      var titleEl = camEl.querySelector('[data-cam-side-title]');
      if (titleEl) titleEl.textContent = SIDE_TITLES[scanSide] || SIDE_TITLES.front;

      // Each card side prints a different layout, so show the matching guide.
      // (SVG elements have no .hidden property — toggle the attribute.)
      var frontGuide = camEl.querySelector('[data-guide="front"]');
      var backGuide = camEl.querySelector('[data-guide="back"]');
      if (frontGuide) frontGuide.toggleAttribute('hidden', scanSide !== 'front');
      if (backGuide) backGuide.toggleAttribute('hidden', scanSide !== 'back');
    }

    function openScanner(root, opts) {
      opts = opts || {};
      scanTarget = (root && root.querySelector) ? root : document.getElementById('add-vehicle-modal');
      var isAdd = Boolean(scanTarget && scanTarget.id === 'add-vehicle-modal');
      scanMode = isAdd ? 'add' : 'manual';
      if (opts.side === 'front' || opts.side === 'back') scanSide = opts.side;
      else scanSide = isAdd ? 'back' : 'front';

      ensureProgress();
      ensureResult();

      // iOS WebKit can expose getUserMedia but still refuses it inside a
      // WebView, and the fallback click after an async rejection is outside
      // the user gesture. Use the native camera input directly there so the
      // Add Vehicle scan always opens something usable.
      if (isIOS() || !canUseCamera()) {
        // Plain HTTP on a LAN address cannot use getUserMedia, but an
        // <input type="file" capture> still opens the phone camera.
        ensureFileInput().click();
        return;
      }
      startCamera();
    }

    document.querySelectorAll('[data-cert-scan]').forEach(function(button) {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        event.stopPropagation();
        var card = button.closest('[data-regcert]');
        // Start with the side the card is currently showing, so scanning the
        // back face prompts for the back first.
        var backFace = card && card.querySelector('[data-cert-face="back"]');
        var side = backFace && !backFace.hidden ? 'back' : 'front';
        openScanner(card, { side: side });
      });
    });

    document.querySelectorAll('[data-modal-scan]').forEach(function(button) {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        event.stopPropagation();
        openScanner(document.getElementById('add-vehicle-modal'), { side: 'back' });
      });
    });
  })();
</script>
