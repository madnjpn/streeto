                  '</g>' +
                  '<g fill="rgba(255,255,255,0.35)" font-family="monospace" font-size="10">' +
                    '<text x="521" y="205" text-anchor="middle">QR</text>' +
                  '</g>' +
                '</svg>' +
                '<span class="camera-frame__corner tl"></span>' +
