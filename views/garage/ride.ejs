                    '<line x1="0" y1="78" x2="600" y2="78"/>' +
                    '<line x1="0" y1="128" x2="600" y2="128"/>' +
                    '<line x1="0" y1="168" x2="600" y2="168"/>' +
                    '<line x1="0" y1="208" x2="600" y2="208"/>' +
                    '<line x1="0" y1="248" x2="600" y2="248"/>' +
                    '<line x1="0" y1="288" x2="600" y2="288"/>' +
                    '<line x1="0" y1="328" x2="600" y2="328"/>' +
                    '<line x1="230" y1="78" x2="230" y2="328"/>' +
